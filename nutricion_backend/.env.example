# Copia este archivo a `.env` y ajústalo.
# Conexión a Postgres (rol 'app', no superusuario, para que aplique el RLS).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/nutricion

# Clave para firmar los tokens JWT. Cámbiala por una cadena larga y aleatoria.
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440
